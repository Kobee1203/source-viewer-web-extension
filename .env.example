# Google Gemini API Key (get one free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: override the default Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: use OpenAI instead of Gemini
# OPENAI_API_KEY=
# Optional: override the default OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
